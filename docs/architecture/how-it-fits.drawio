<mxfile host="app.diagrams.net" type="device">
  <diagram id="how-it-fits" name="How it fits">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="880" background="#fbfbf7" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b style=&quot;font-size:28px&quot;&gt;purrpose&lt;font color=&quot;#aa7d48&quot;&gt;.&lt;/font&gt;&lt;/b&gt; &lt;span style=&quot;font-size:18px&quot;&gt;How the parts fit&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#62736d&quot;&gt;Solid wires carry the request. Dashed wires are calls the orchestrator makes. Hover a node for its notes.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#203c35;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="900" height="64" as="geometry"/></mxCell>
        <mxCell id="lg0" value="" style="ellipse;fillColor=#aa7d48;strokeColor=#ffffff;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1060" y="40" width="12" height="12" as="geometry"/></mxCell>
        <mxCell id="lgt0" value="not built yet" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=13;fontColor=#62736d;" vertex="1" parent="1"><mxGeometry x="1078" y="34" width="110" height="24" as="geometry"/></mxCell>
        <mxCell id="lg1" value="" style="ellipse;fillColor=#3f8a66;strokeColor=#ffffff;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1200" y="40" width="12" height="12" as="geometry"/></mxCell>
        <mxCell id="lgt1" value="running" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=13;fontColor=#62736d;" vertex="1" parent="1"><mxGeometry x="1218" y="34" width="110" height="24" as="geometry"/></mxCell>
        <UserObject id="t1" label="&lt;b style=&quot;font-size:14px&quot;&gt;Donor asks&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#62736d&quot;&gt;&quot;Can I help this cat?&quot;&lt;/span&gt;" tooltip="Trigger · our app&#10;&#10;A supporter asks about one case, or asks to find one. The app asks once which city they prefer and never asks for a name or an amount.&#10;&#10;• Starts a review of the case&#10;• Records which region and city the person asked about&#10;&#10;Read: R04 · FULL_GUIDANCE §5"><mxCell style="shape=delay;flipH=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c7bc;strokeWidth=1.5;shadow=0;fontFamily=Segoe UI;fontColor=#203c35;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;spacingTop=4;labelWidth=150;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="92" height="92" as="geometry"/></mxCell></UserObject>
        <mxCell id="ic0" value="" style="shape=image;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSIjMjI0ZjQzIiBzdHJva2Utd2lkdGg9IjEuNyIgc3Ryb2tlLWxpbmVjYXA9InJvdW5kIiBzdHJva2UtbGluZWpvaW49InJvdW5kIj48cGF0aCBkPSJNMTMgMyA1IDEzaDZsLTEgOCA4LTEwaC02bDEtOHoiLz48L3N2Zz4=;imageAspect=1;movable=0;resizable=0;editable=0;" vertex="1" parent="t1"><mxGeometry x="29" y="29" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="st0" value="" style="ellipse;fillColor=#aa7d48;strokeColor=#ffffff;strokeWidth=2;movable=0;resizable=0;" vertex="1" parent="t1"><mxGeometry x="85" y="-5" width="12" height="12" as="geometry"/></mxCell>
        <UserObject id="t2" label="&lt;b style=&quot;font-size:14px&quot;&gt;Rescue updates&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#62736d&quot;&gt;public page changed&lt;/span&gt;" tooltip="Trigger · our app&#10;&#10;A rescue changes its public case page, for example to say whether a grant is included in the amount raised. The notification alone is not evidence: the page has to be read and checked.&#10;&#10;• Starts a re-review of only the checks the change affects&#10;• Starts from what memory already holds&#10;&#10;Read: R05, R10 · FULL_GUIDANCE §6, §12"><mxCell style="shape=delay;flipH=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c7bc;strokeWidth=1.5;shadow=0;fontFamily=Segoe UI;fontColor=#203c35;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;spacingTop=4;labelWidth=150;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="92" height="92" as="geometry"/></mxCell></UserObject>
        <mxCell id="ic1" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;movable=0;resizable=0;editable=0;" vertex="1" parent="t2"><mxGeometry x="29" y="29" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="st1" value="" style="ellipse;fillColor=#aa7d48;strokeColor=#ffffff;strokeWidth=2;movable=0;resizable=0;" vertex="1" parent="t2"><mxGeometry x="85" y="-5" width="12" height="12" as="geometry"/></mxCell>
        <UserObject id="agent" label="&lt;b style=&quot;font-size:16px&quot;&gt;Purrpose orchestrator&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#62736d&quot;&gt;our backend · plans the steps&lt;/span&gt;" tooltip="Our code (Python suggested)&#10;&#10;One orchestrator, the program we write. It decides which tool to call next and stays within the call budget. It hands every decision to plain code.&#10;&#10;• Calls the model, memory and tools through the dashed wires&#10;• At most one model extraction call per review by default (R13)&#10;• Never lets a model change money or qualification (R12)&#10;&#10;Read: R12, R13 · FULL_GUIDANCE §16"><mxCell style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c7bc;strokeWidth=1.5;shadow=0;fontFamily=Segoe UI;fontColor=#203c35;align=left;verticalAlign=middle;spacingLeft=66;" vertex="1" parent="1"><mxGeometry x="230" y="280" width="270" height="92" as="geometry"/></mxCell></UserObject>
        <mxCell id="ic2" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;movable=0;resizable=0;editable=0;" vertex="1" parent="agent"><mxGeometry x="18" y="29" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="st2" value="" style="ellipse;fillColor=#aa7d48;strokeColor=#ffffff;strokeWidth=2;movable=0;resizable=0;" vertex="1" parent="agent"><mxGeometry x="263" y="-5" width="12" height="12" as="geometry"/></mxCell>
        <UserObject id="runtime" label="&lt;b style=&quot;font-size:14px&quot;&gt;Meterless Runtime&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#62736d&quot;&gt;via Nightshift&lt;/span&gt;" tooltip="Hackathon Power rule&#10;&#10;The switchboard. Our app sends model requests to one OpenAI-style address with a token, and Nightshift passes them on to the model it is set up to use.&#10;&#10;• The only model address our app knows&#10;• Satisfies the rule “Meterless Nightshift as primary AI provider”&#10;&#10;Note: Nightshift for Windows needs a dedicated GPU. On 23 Oct the Meterless team said in the HackOS Help Meterless channel: build the Runtime provider into the app and test with NVIDIA’s hosted API.&#10;&#10;Read: FULL_GUIDANCE §19 Nightshift"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c7bc;strokeWidth=1.5;shadow=0;fontFamily=Segoe UI;fontColor=#203c35;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;spacingTop=4;labelWidth=120;" vertex="1" parent="1"><mxGeometry x="251" y="480" width="66" height="66" as="geometry"/></mxCell></UserObject>
        <mxCell id="ic3" value="" style="shape=image;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSIjMjI0ZjQzIiBzdHJva2Utd2lkdGg9IjEuNyIgc3Ryb2tlLWxpbmVjYXA9InJvdW5kIiBzdHJva2UtbGluZWpvaW49InJvdW5kIj48cGF0aCBkPSJNNyAzdjVNMTcgM3Y1TTUgOGgxNHY0YTcgNyAwIDAgMS0xNCAwVjh6TTEyIDE5djIiLz48L3N2Zz4=;imageAspect=1;movable=0;resizable=0;editable=0;" vertex="1" parent="runtime"><mxGeometry x="19" y="19" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="st3" value="" style="ellipse;fillColor=#aa7d48;strokeColor=#ffffff;strokeWidth=2;movable=0;resizable=0;" vertex="1" parent="runtime"><mxGeometry x="50.1" y="3.9000000000000004" width="12" height="12" as="geometry"/></mxCell>
        <UserObject id="nemotron" label="&lt;b style=&quot;font-size:14px&quot;&gt;NVIDIA Nemotron&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#62736d&quot;&gt;hosted model&lt;/span&gt;" tooltip="The model that reads&#10;&#10;The AI model behind the Runtime. It reads the vet estimate and proposes facts, each with where on the page it found them.&#10;&#10;• Proposes treatment, cost and date as candidates&#10;• The code then checks every proposed fact&#10;• The NVIDIA key goes in Nightshift, never in our app&#10;&#10;Read: R12 · FULL_GUIDANCE §17"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c7bc;strokeWidth=1.5;shadow=0;fontFamily=Segoe UI;fontColor=#203c35;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;spacingTop=4;labelWidth=120;" vertex="1" parent="1"><mxGeometry x="251" y="650" width="66" height="66" as="geometry"/></mxCell></UserObject>
        <mxCell id="ic4" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;movable=0;resizable=0;editable=0;" vertex="1" parent="nemotron"><mxGeometry x="19" y="19" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="st4" value="" style="ellipse;fillColor=#aa7d48;strokeColor=#ffffff;strokeWidth=2;movable=0;resizable=0;" vertex="1" parent="nemotron"><mxGeometry x="50.1" y="3.9000000000000004" width="12" height="12" as="geometry"/></mxCell>
        <UserObject id="hmem" label="&lt;b style=&quot;font-size:14px&quot;&gt;H-MEM&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#62736d&quot;&gt;Meterless memory engine&lt;/span&gt;" tooltip="Hackathon Build rule&#10;&#10;Memory with citations. Every finding keeps its source, and nothing is overwritten. It is an engine we build from Meterless’s reference code and test suite, not a hosted service.&#10;&#10;• Recalls what is already known and what is still open&#10;• Saves new findings after each review&#10;• Keeps history honest: an old answer uses only what was known then&#10;&#10;Proof: The conformance tests pass, and the demo shows a recall after an update.&#10;&#10;Read: R11 · FULL_GUIDANCE §14"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c7bc;strokeWidth=1.5;shadow=0;fontFamily=Segoe UI;fontColor=#203c35;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;spacingTop=4;labelWidth=120;" vertex="1" parent="1"><mxGeometry x="375" y="480" width="66" height="66" as="geometry"/></mxCell></UserObject>
        <mxCell id="ic5" value="" style="shape=image;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSIjMjI0ZjQzIiBzdHJva2Utd2lkdGg9IjEuNyIgc3Ryb2tlLWxpbmVjYXA9InJvdW5kIiBzdHJva2UtbGluZWpvaW49InJvdW5kIj48cGF0aCBkPSJNNSA0aDExbDMgM3YxM0g1eiIvPjxwYXRoIGQ9Ik04IDloOE04IDEzaDhNOCAxN2g1Ii8+PC9zdmc+;imageAspect=1;movable=0;resizable=0;editable=0;" vertex="1" parent="hmem"><mxGeometry x="19" y="19" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="st5" value="" style="ellipse;fillColor=#aa7d48;strokeColor=#ffffff;strokeWidth=2;movable=0;resizable=0;" vertex="1" parent="hmem"><mxGeometry x="50.1" y="3.9000000000000004" width="12" height="12" as="geometry"/></mxCell>
        <UserObject id="zetaris" label="&lt;b style=&quot;font-size:14px&quot;&gt;Zetaris&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#62736d&quot;&gt;one SQL query across sources&lt;/span&gt;" tooltip="Hackathon Data rule&#10;&#10;A query layer. It reads separate sources where they live and lets us join them in one SQL query, keeping which source each row came from.&#10;&#10;• Answers: does the registry match the name and city on the case page?&#10;• Returns funding rows with their dates&#10;&#10;Note: Running locally (REST on port 18888). No Purrpose tables yet. Sources must be in S3, a database or a REST API, not local files.&#10;&#10;Read: R07 · FULL_GUIDANCE §19 Zetaris"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c7bc;strokeWidth=1.5;shadow=0;fontFamily=Segoe UI;fontColor=#203c35;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;spacingTop=4;labelWidth=120;" vertex="1" parent="1"><mxGeometry x="520" y="480" width="66" height="66" as="geometry"/></mxCell></UserObject>
        <mxCell id="ic6" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;movable=0;resizable=0;editable=0;" vertex="1" parent="zetaris"><mxGeometry x="19" y="19" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="st6" value="" style="ellipse;fillColor=#3f8a66;strokeColor=#ffffff;strokeWidth=2;movable=0;resizable=0;" vertex="1" parent="zetaris"><mxGeometry x="50.1" y="3.9000000000000004" width="12" height="12" as="geometry"/></mxCell>
        <UserObject id="src1" label="&lt;b style=&quot;font-size:14px&quot;&gt;CRA charity list&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#62736d&quot;&gt;registration status&lt;/span&gt;" tooltip="Source&#10;&#10;The Canada Revenue Agency’s list of registered charities: name, status, address. The bulk download is a yearly snapshot, and live status is a web search.&#10;&#10;• Identity check (check 1 of 6)&#10;&#10;Read: R09 · FULL_GUIDANCE §13"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c7bc;strokeWidth=1.5;shadow=0;fontFamily=Segoe UI;fontColor=#203c35;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;spacingTop=4;labelWidth=120;" vertex="1" parent="1"><mxGeometry x="420" y="650" width="66" height="66" as="geometry"/></mxCell></UserObject>
        <mxCell id="ic7" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;movable=0;resizable=0;editable=0;" vertex="1" parent="src1"><mxGeometry x="19" y="19" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="st7" value="" style="ellipse;fillColor=#aa7d48;strokeColor=#ffffff;strokeWidth=2;movable=0;resizable=0;" vertex="1" parent="src1"><mxGeometry x="50.1" y="3.9000000000000004" width="12" height="12" as="geometry"/></mxCell>
        <UserObject id="src2" label="&lt;b style=&quot;font-size:14px&quot;&gt;Case page&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#62736d&quot;&gt;the rescue’s own site&lt;/span&gt;" tooltip="Source&#10;&#10;The rescue’s public page for this cat: the request, the city where treatment happens, and the medical material.&#10;&#10;• Medical check, and the city used for sorting&#10;&#10;Read: R05, R07"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c7bc;strokeWidth=1.5;shadow=0;fontFamily=Segoe UI;fontColor=#203c35;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;spacingTop=4;labelWidth=120;" vertex="1" parent="1"><mxGeometry x="540" y="650" width="66" height="66" as="geometry"/></mxCell></UserObject>
        <mxCell id="ic8" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;movable=0;resizable=0;editable=0;" vertex="1" parent="src2"><mxGeometry x="19" y="19" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="st8" value="" style="ellipse;fillColor=#aa7d48;strokeColor=#ffffff;strokeWidth=2;movable=0;resizable=0;" vertex="1" parent="src2"><mxGeometry x="50.1" y="3.9000000000000004" width="12" height="12" as="geometry"/></mxCell>
        <UserObject id="src3" label="&lt;b style=&quot;font-size:14px&quot;&gt;Funding disclosure&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#62736d&quot;&gt;raised, grants, dates&lt;/span&gt;" tooltip="Source&#10;&#10;The dated statement of how much is needed and how much has been raised, including any grants.&#10;&#10;• Funding checks (checks 3 and 4)&#10;&#10;Read: R08 · FULL_GUIDANCE §9"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c7bc;strokeWidth=1.5;shadow=0;fontFamily=Segoe UI;fontColor=#203c35;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;spacingTop=4;labelWidth=120;" vertex="1" parent="1"><mxGeometry x="660" y="650" width="66" height="66" as="geometry"/></mxCell></UserObject>
        <mxCell id="ic9" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;movable=0;resizable=0;editable=0;" vertex="1" parent="src3"><mxGeometry x="19" y="19" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="st9" value="" style="ellipse;fillColor=#aa7d48;strokeColor=#ffffff;strokeWidth=2;movable=0;resizable=0;" vertex="1" parent="src3"><mxGeometry x="50.1" y="3.9000000000000004" width="12" height="12" as="geometry"/></mxCell>
        <UserObject id="checks" label="&lt;b style=&quot;font-size:14px&quot;&gt;Six checks&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#62736d&quot;&gt;and funding maths, in code&lt;/span&gt;" tooltip="Our code&#10;&#10;Plain code with no model involved. It runs the six checks and calculates the remaining amount. Unknown stays unknown and is never counted as zero.&#10;&#10;• Identity, medical, costs dated, positive remainder, donation link, risk&#10;• 2,000 − 700 − 300 = 1,000 if the grant is separate; unknown if unclear&#10;&#10;Read: R06, R08 · FULL_GUIDANCE §7, §9"><mxCell style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c7bc;strokeWidth=1.5;shadow=0;fontFamily=Segoe UI;fontColor=#203c35;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;spacingTop=4;labelWidth=150;" vertex="1" parent="1"><mxGeometry x="640" y="280" width="92" height="92" as="geometry"/></mxCell></UserObject>
        <mxCell id="ic10" value="" style="shape=image;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSIjMjI0ZjQzIiBzdHJva2Utd2lkdGg9IjEuNyIgc3Ryb2tlLWxpbmVjYXA9InJvdW5kIiBzdHJva2UtbGluZWpvaW49InJvdW5kIj48cGF0aCBkPSJNNSA0aDE0djE2SDV6Ii8+PHBhdGggZD0ibTggOSAyIDIgNC00TTggMTVoOCIvPjwvc3ZnPg==;imageAspect=1;movable=0;resizable=0;editable=0;" vertex="1" parent="checks"><mxGeometry x="29" y="29" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="st10" value="" style="ellipse;fillColor=#aa7d48;strokeColor=#ffffff;strokeWidth=2;movable=0;resizable=0;" vertex="1" parent="checks"><mxGeometry x="85" y="-5" width="12" height="12" as="geometry"/></mxCell>
        <UserObject id="gate" label="&lt;b style=&quot;font-size:14px&quot;&gt;All six pass?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#62736d&quot;&gt;qualified or pending&lt;/span&gt;" tooltip="Our code&#10;&#10;The fork in the road. Only a case that passes every check is shown as qualified. Anything else is pending, with the reason.&#10;&#10;• Qualification applies to this case only, not to every request by the organization&#10;&#10;Read: R06"><mxCell style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c7bc;strokeWidth=1.5;shadow=0;fontFamily=Segoe UI;fontColor=#203c35;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;spacingTop=4;labelWidth=150;" vertex="1" parent="1"><mxGeometry x="820" y="280" width="92" height="92" as="geometry"/></mxCell></UserObject>
        <mxCell id="ic11" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;movable=0;resizable=0;editable=0;" vertex="1" parent="gate"><mxGeometry x="29" y="29" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="st11" value="" style="ellipse;fillColor=#aa7d48;strokeColor=#ffffff;strokeWidth=2;movable=0;resizable=0;" vertex="1" parent="gate"><mxGeometry x="85" y="-5" width="12" height="12" as="geometry"/></mxCell>
        <UserObject id="qual" label="&lt;b style=&quot;font-size:14px&quot;&gt;Show qualified case&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#62736d&quot;&gt;with every source&lt;/span&gt;" tooltip="Result page&#10;&#10;The supporter sees the case, its sources and the remaining amount, plus what has not been independently confirmed.&#10;&#10;• Ordered by city, organization and case name, never by a trust score&#10;&#10;Read: R04 · FULL_GUIDANCE §5.4"><mxCell style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c7bc;strokeWidth=1.5;shadow=0;fontFamily=Segoe UI;fontColor=#203c35;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;spacingTop=4;labelWidth=150;" vertex="1" parent="1"><mxGeometry x="1030" y="140" width="92" height="92" as="geometry"/></mxCell></UserObject>
        <mxCell id="ic12" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;movable=0;resizable=0;editable=0;" vertex="1" parent="qual"><mxGeometry x="29" y="29" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="st12" value="" style="ellipse;fillColor=#aa7d48;strokeColor=#ffffff;strokeWidth=2;movable=0;resizable=0;" vertex="1" parent="qual"><mxGeometry x="85" y="-5" width="12" height="12" as="geometry"/></mxCell>
        <UserObject id="link" label="&lt;b style=&quot;font-size:14px&quot;&gt;Rescue’s own donation link&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#62736d&quot;&gt;Purrpose handles no money&lt;/span&gt;" tooltip="External link&#10;&#10;A checked link to the organization’s own donation channel. Purrpose never takes, sends or processes money.&#10;&#10;• The link is checked to belong to the same organization (check 5)&#10;&#10;Read: R15 · FULL_GUIDANCE §10"><mxCell style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c7bc;strokeWidth=1.5;shadow=0;fontFamily=Segoe UI;fontColor=#203c35;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;spacingTop=4;labelWidth=150;" vertex="1" parent="1"><mxGeometry x="1230" y="140" width="92" height="92" as="geometry"/></mxCell></UserObject>
        <mxCell id="ic13" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;movable=0;resizable=0;editable=0;" vertex="1" parent="link"><mxGeometry x="29" y="29" width="34" height="34" as="geometry"/></mxCell>
