        <UserObject id="zetaris" label="&lt;b style=&quot;font-size:14px&quot;&gt;Zetaris&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#62736d&quot;&gt;one SQL layer across sources&lt;/span&gt;" tooltip="Hackathon Data rule&#10;&#10;A query layer that reads separate sources where they live and joins them in one SQL query, keeping which source each row came from.&#10;&#10;• A read-only query returned one historical registry record (2024)&#10;&#10;Today: Tested separately&#10;&#10;Note: Not yet wired into the running review. A historical record cannot prove current status.&#10;&#10;Read: R07 · FULL_GUIDANCE §19 Zetaris"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c7bc;strokeWidth=1.5;shadow=0;fontFamily=Segoe UI;fontColor=#203c35;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;spacingTop=4;labelWidth=120;" vertex="1" parent="1"><mxGeometry x="670" y="690" width="66" height="66" as="geometry"/></mxCell></UserObject>
        <mxCell id="ic-zetaris" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;movable=0;resizable=0;editable=0;" vertex="1" parent="zetaris"><mxGeometry x="19" y="19" width="28" height="28" as="geometry"/></mxCell>
