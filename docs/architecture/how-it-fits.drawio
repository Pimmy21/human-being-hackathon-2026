        <UserObject id="pend" label="&lt;b style=&quot;font-size:14px&quot;&gt;Show pending case&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#62736d&quot;&gt;what is missing, and where&lt;/span&gt;" tooltip="Result page&#10;&#10;An honest pending result: the known facts, what is missing, and where it could come from. Missing information does not mean dishonesty.&#10;&#10;• Never invents a remaining amount&#10;&#10;Read: R06 · FULL_GUIDANCE §5.4"><mxCell style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c7bc;strokeWidth=1.5;shadow=0;fontFamily=Segoe UI;fontColor=#203c35;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;spacingTop=4;labelWidth=150;" vertex="1" parent="1"><mxGeometry x="1030" y="430" width="92" height="92" as="geometry"/></mxCell></UserObject>
