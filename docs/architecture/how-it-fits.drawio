        <UserObject id="gaps" label="&lt;b style=&quot;font-size:14px&quot;&gt;Gap list for the rescue&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#62736d&quot;&gt;what to add and why&lt;/span&gt;" tooltip="Result page&#10;&#10;The rescue gets a practical list of what is satisfied, missing, expired or conflicting, and what to add to its public page.&#10;&#10;• Public links only, no private uploads&#10;&#10;Read: R05 · FULL_GUIDANCE §6"><mxCell style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c7bc;strokeWidth=1.5;shadow=0;fontFamily=Segoe UI;fontColor=#203c35;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;spacingTop=4;labelWidth=150;" vertex="1" parent="1"><mxGeometry x="1230" y="430" width="92" height="92" as="geometry"/></mxCell></UserObject>
