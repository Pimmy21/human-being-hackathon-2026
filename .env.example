# Copy to .env.local (ignored). Never commit real credentials.
# Leave the provider empty for no model calls; use nvidia_direct to enable NVIDIA.
PURRPOSE_MODEL_PROVIDER=
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Alternative route: meterless. Requires a real compatible runtime, not just a Web tab.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=meterless/auto

# Small demo allowance. Account holder must approve and adjust caps.
# Per-process counters reset on restart. Do not use restarts to bypass an allowance.
PURRPOSE_MODEL_MAX_CALLS=3
PURRPOSE_MODEL_TOKEN_CAP=15000
PURRPOSE_MODEL_CALLS_PER_MINUTE=3
PURRPOSE_MODEL_INPUT_CHARS=6000
PURRPOSE_MODEL_OUTPUT_TOKENS=128
PURRPOSE_MODEL_TIMEOUT_SECONDS=10

# Remote Zetaris JDBC. Copy the exact SSL-enabled URL from your account owner.
# Do not place username/password in a public URL or commit them.
ZETARIS_JDBC_URL=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
# Absolute vendor JAR path. The driver is not distributed in this repository.
ZETARIS_JDBC_JAR=
