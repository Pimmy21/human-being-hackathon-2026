# Copy to .env.local (git-ignored) and fill in. Never commit real keys.
# Without PURRPOSE_MODEL_PROVIDER the chat model is off and the app makes no model calls.

# Choose exactly one route. There is no automatic fallback between them.
#   nvidia_direct  hosted NVIDIA API (no-GPU route). NOT counted as Nightshift use.
#   meterless      Meterless Runtime / Nightshift on this machine (loopback only).
PURRPOSE_MODEL_PROVIDER=nvidia_direct

# nvidia_direct: your own key from build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# meterless: base URL, token from the Nightshift Console (rt-local is rejected), routing mode
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=meterless/auto

# Hard caps set by the account owner. Any missing or invalid value blocks model calls.
PURRPOSE_MODEL_MAX_CALLS=200
PURRPOSE_MODEL_TOKEN_CAP=100000
PURRPOSE_MODEL_CALLS_PER_MINUTE=20
PURRPOSE_MODEL_INPUT_CHARS=4000
PURRPOSE_MODEL_OUTPUT_TOKENS=300
# 30 for nvidia_direct; the Meterless provider contract asks for 180
PURRPOSE_MODEL_TIMEOUT_SECONDS=30
